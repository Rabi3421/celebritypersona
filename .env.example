# Copy to .env.local and fill in. Never commit the filled version.

MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0"
MONGODB_DB="celebritypersona"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# The only address allowed to sign in to /admin.
ADMIN_EMAIL=""

NEXT_PUBLIC_SITE_URL="https://celebritypersona.com"

# Firebase web config, for outfit image storage.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Instagram reels on the homepage. Optional: with no token the section falls
# back to the rows typed into the homepage form.
#
# Needs an Instagram professional account (Business or Creator) connected to a
# Meta app using "Instagram API with Instagram Login", then a long-lived token
# with the instagram_business_basic scope. The token lasts 60 days — extend it
# with `npm run instagram:refresh` before it lapses.
